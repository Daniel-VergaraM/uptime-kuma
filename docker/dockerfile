ARG BASE_IMAGE=louislam/uptime-kuma:base3

############################################
# Build in Golang

# Check file: builder-go.dockerfile
############################################
FROM louislam/uptime-kuma:builder-go3 AS build_healthcheck

############################################
# Build in Node.js
############################################
FROM louislam/uptime-kuma:base3 AS build
USER node
WORKDIR /app

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1
COPY --chown=node:node .npmrc .npmrc
COPY --chown=node:node package.json package.json
COPY --chown=node:node package-lock.json package-lock.json
RUN npm ci
COPY --chown=node:node . .
# dist/ is git-ignored, so the image must build the frontend itself. Then drop dev dependencies.
RUN npm run build && npm prune --omit=dev
COPY --chown=node:node --from=build_healthcheck /app/extra/healthcheck /app/extra/healthcheck
RUN mkdir ./data

############################################
# ⭐ Main Image
############################################
FROM $BASE_IMAGE AS release
WORKDIR /app

LABEL org.opencontainers.image.source="https://github.com/louislam/uptime-kuma"

ENV UPTIME_KUMA_IS_CONTAINER=1

# Copy app files from build layer
COPY --chown=node:node --from=build /app /app

EXPOSE 3001
HEALTHCHECK --interval=60s --timeout=30s --start-period=180s --retries=5 CMD extra/healthcheck
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "--import=tsx", "server/server.js"]
